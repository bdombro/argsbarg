{
  "$schema": "https://biomejs.dev/schemas/2.5.0/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "off" } } },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": false,
      "correctness": {
        "noUnsafeFinally": "error"
      },
      "security": {
        "noGlobalEval": "error"
      }
    }
  },
  "formatter": {
    "enabled": false
  },
  "overrides": [
    {
      "includes": ["**/*.json"]
    },
    {
      "includes": [
        "**/completion-bash.ts",
        "**/completion-simulate-shared.ts",
        "**/completion-zsh.ts"
      ]
    }
  ]
}
